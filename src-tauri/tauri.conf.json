{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.open-meteo.com https://github.com https://api.github.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "alwaysOnTop": true,
        "decorations": false,
        "fullscreen": false,
        "height": 380,
        "label": "notch",
        "minHeight": 32,
        "minWidth": 200,
        "resizable": false,
        "skipTaskbar": true,
        "title": "NotchKu",
        "transparent": true,
        "visible": true,
        "width": 560
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": [
      "icons/icon.ico"
    ],
    "longDescription": "NotchKu \u2014 a small interactive notch at the top of your screen: music, calendar, todo, pomodoro and weather.",
    "shortDescription": "Interactive notch for Windows",
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "identifier": "id.zarski.notchku",
  "plugins": {},
  "productName": "NotchKu",
  "version": "0.1.0"
}
